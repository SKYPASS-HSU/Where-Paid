# 이 파일을 local.properties로 복사해서 값을 채운다. local.properties는 커밋하지 않는다.
#   cp local.properties.example local.properties
# 아래 값이 모두 비어 있어도 빌드와 에뮬레이터 실행은 된다. 자세한 설명은 README.md.

# Android SDK 위치. Android Studio로 프로젝트를 열면 자동으로 채워진다.
# sdk.dir=/Users/<이름>/Library/Android/sdk

# --- 팀 공용 서명 키 (팀 채널에서 team.jks와 비밀번호를 받는다) ---
# 경로는 저장소 루트 기준. keystore/ 폴더는 .gitignore에 들어 있다.
signing.storeFile=keystore/team.jks
signing.storePassword=
signing.keyAlias=
signing.keyPassword=

# --- 카카오 개발자 콘솔의 앱 키 (팀 공용 앱 1개) ---
# 네이티브 앱 키: 카카오맵 SDK
kakao.nativeAppKey=
# REST API 키: 카카오 로컬 API(장소 검색)
kakao.restApiKey=

# --- LLM 중계 서버 (월간 리포트 칭호·요약, server/llm-relay) ---
# 주소는 비밀이 아니다. 토큰은 ④에게 개인톡으로 받는다. 비우면 앱은 가짜 리포트를 쓴다.
wherepaid.relayUrl=https://wherepaid-llm-relay.skypass-hsu.workers.dev
wherepaid.relayToken=

# --- 개발 옵션 ---
# true(기본): 메모리의 가짜 거래를 보여준다. false: 기기 DB(Room)를 쓴다.
wherepaid.useFakeData=true
