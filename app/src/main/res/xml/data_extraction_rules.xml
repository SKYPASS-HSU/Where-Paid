<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12(API 31) 이상의 백업 범위. backup_rules.xml과 같은 내용을 유지한다.
    cloud-backup: 본인 Google 계정 백업, device-transfer: 새 폰으로 옮길 때.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
